[Unit]
Description=Türkiye bilgi yarışması (SSE)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/bilgi-yarismasi
ExecStart=/usr/bin/python3 sunucu.py
Restart=always
RestartSec=5
MemoryMax=250M
CPUQuota=50%
TasksMax=600
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
